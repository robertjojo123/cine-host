-- farmer.lua (revised)
-- Fixes:
-- 1) Removed extra turnRight() before placement
-- 2) Ensures facing correctly after reboot (no 180° error)

--------------------- CONFIG ------------------------
local STATE_FILE = "farmer_state.json"
local CLEAR_ON_RESUME = true
local WAIT_POLL_SEC = 2
local TAKE_COUNT = 8
local DROP_COUNT = 8

------------------- STATE / LOAD --------------------
local state = {
  x = 0, z = 0, dir = 0,
  go_dir = nil,     -- we will store startup direction ONCE
  resumed = false
}

local function save()
  local f = fs.open(STATE_FILE, "w")
  f.write(textutils.serializeJSON(state))
  f.close()
end

local function load()
  if not fs.exists(STATE_FILE) then save() return false end

  local ok, data = pcall(function()
    local f = fs.open(STATE_FILE, "r")
    local t = textutils.unserializeJSON(f.readAll())
    f.close()
    return t
  end)

  if ok and data and data.x and data.z and data.dir then
    state = data
    state.resumed = true
    return true
  end

  save()
  return false
end

------------------ MOVEMENT CORE --------------------
local function fwd()
  if not turtle.forward() then
    turtle.dig()
    turtle.attack()
    sleep(0.1)
    if not turtle.forward() then error("blocked forward") end
  end
end

local function sfwd(n)
  for _=1,(n or 1) do
    fwd()
    if state.dir == 0 then state.z = state.z - 1
    elseif state.dir == 1 then state.x = state.x + 1
    elseif state.dir == 2 then state.z = state.z + 1
    else state.x = state.x - 1 end
    save()
  end
end

local function sl() turtle.turnLeft();  state.dir = (state.dir + 3) % 4; save() end
local function sr() turtle.turnRight(); state.dir = (state.dir + 1) % 4; save() end

local function face(d)
  local t = (d - state.dir) % 4
  if t == 1 then sr()
  elseif t == 2 then sr(); sr()
  elseif t == 3 then sl()
  end
end

local function goto(x,z)
  local dx, dz = x - state.x, z - state.z
  if dx ~= 0 then face(dx>0 and 1 or 3); sfwd(math.abs(dx)) end
  if dz ~= 0 then face(dz>0 and 2 or 0); sfwd(math.abs(dz)) end
end

local function goHome()
  goto(0,0)
  face(state.go_dir)   -- FIX: always face correct startup direction
end

------------------- UTILITIES -----------------------
local function waitCropChange(before)
  while true do
    local ok, d = turtle.inspectDown()
    if (ok and d.name or "none") ~= before then return end
    sleep(WAIT_POLL_SEC)
  end
end

----------------- IN / OUT MOTIONS ------------------
local function intake()
  sr()
  sfwd(1)
  turtle.suckDown(TAKE_COUNT)
  sl(); sl()
  sfwd(1)
  sr()
  -- **DO NOT turn again here** (this caused the extra rotation in the old code)
end

-- ✅ FIX: placement pattern now starts WITHOUT extra turnRight()
local function placement()
  -- You are already facing correct direction here
  sfwd(2)
  turtle.placeDown(); sfwd(1); turtle.placeDown()

  sl(); sfwd(1); turtle.placeDown(); sfwd(1); turtle.placeDown()
  sl(); sfwd(1); turtle.placeDown(); sfwd(1); turtle.placeDown()
  sl(); sfwd(1); turtle.placeDown(); sfwd(1); turtle.placeDown()
end

local function harvestAndReturn()
  turtle.digDown()
  sl(); sfwd(1); turtle.digDown()
  sfwd(1); turtle.digDown()
  sl(); sfwd(1); turtle.digDown()
  sfwd(1); turtle.digDown()
  sl(); sfwd(1); turtle.digDown()
  sfwd(1)
  sr(); sfwd(2)
  turtle.dropDown(DROP_COUNT)
  sl(); sl()
  sfwd(1)
end

------------------- CLEAR PASS ----------------------
local function clearField()
  goHome()
  face(1)
  for row = 1,3 do
    for col = 1,2 do
      turtle.digDown()
      if col < 2 then sfwd(1) end
    end
    turtle.digDown()
    if row < 3 then
      if row % 2 == 1 then sr(); sfwd(1); sr() else sl(); sfwd(1); sl() end
    end
  end
  goHome()
end

------------------- STARTUP -------------------------
local resumed = load()

if not state.go_dir then
  -- first-run only: record launch direction
  state.go_dir = state.dir
  save()
end

goHome()          -- ensures correct position
face(state.go_dir) -- ✅ ensures correct facing (fix to 180° bug)

if resumed and CLEAR_ON_RESUME then
  clearField()
  state.resumed = false
  save()
end

------------------- MAIN LOOP -----------------------
while true do
  intake()

  placement()  -- ✅ no extra turn

  local ok, d = turtle.inspectDown()
  waitCropChange((ok and d.name) or "none")

  harvestAndReturn()

  goHome()
end
